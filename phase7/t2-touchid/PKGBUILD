# Maintainer: arch-mact2 local package
_kait2en_commit=e661ff21f4eeecc6208ee3ff60ad17f90dc9d249
pkgname=t2-touchid
pkgver=0.1.0
pkgrel=1
pkgdesc='Bridge Apple T2 Touch ID to fprintd using macOS-enrolled fingerprints'
arch=('x86_64')
url='https://github.com/kaiT2en/KaiT2en-Fedora/tree/main/t2-services/t2-touchid'
license=('GPL-3.0-or-later')
depends=('dbus' 'fprintd' 'libfprint' 'libinput' 'systemd' 't2-services-common')
makedepends=('make' 'rust')
backup=('etc/kait2en/t2-touchid.conf')
source=("kait2en-${_kait2en_commit}.tar.gz::https://codeload.github.com/kaiT2en/KaiT2en-Fedora/tar.gz/${_kait2en_commit}")
sha256sums=('e82c6911bcd99eb5f131941c601a33774f9cdc6bb53338cf99dcaf2c09cc4eac')

# Build and install only the upstream Touch ID bridge. No PAM configuration,
# fingerprint binding, service enablement, SEP mailbox module, or suspend hook
# is installed or activated by this package.
build() {
	local _srcdir="${srcdir}/KaiT2en-Fedora-${_kait2en_commit}/t2-services/t2-touchid"
	CARGO_TARGET_DIR="${srcdir}/cargo-target" \
		make -C "${_srcdir}" build CARGO_FLAGS='--locked'
}

check() {
	local _srcdir="${srcdir}/KaiT2en-Fedora-${_kait2en_commit}/t2-services/t2-touchid"
	CARGO_TARGET_DIR="${srcdir}/cargo-target" \
		make -C "${_srcdir}" test CARGO_FLAGS='--locked'
}

package() {
	local _srcdir="${srcdir}/KaiT2en-Fedora-${_kait2en_commit}/t2-services/t2-touchid"
	make -C "${_srcdir}" install \
		PREFIX=/usr \
		BINDIR=/usr/bin \
		SYSTEMD_UNIT_DIR=/usr/lib/systemd/system \
		DATADIR=/usr/share \
		SYSCONFDIR=/etc \
		DESTDIR="${pkgdir}" \
		CARGO_TARGET_DIR="${srcdir}/cargo-target" \
		CARGO_FLAGS='--locked'
	install -Dm644 "${_srcdir}/LICENSE" \
		"${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
	install -Dm644 "${_srcdir}/README.md" \
		"${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
